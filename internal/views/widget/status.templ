package widget

import (
	"fmt"

	"github.com/tiponero/tiponero-core/internal/database"
	"github.com/tiponero/tiponero-core/internal/views/components"
)

func confirmationPercent(confirmations, required int) int {
	if required <= 0 {
		return 100
	}
	percent := confirmations * 100 / required
	if percent > 100 {
		return 100
	}
	return percent
}

// statusURL returns the polling endpoint for a transaction. Widget payments
// and standalone payment requests use different routes.
func statusURL(tx *database.Transaction) string {
	if tx.WidgetID.Valid {
		return fmt.Sprintf("/widget/%s/donation/%s/status", tx.WidgetID.String, tx.ID)
	}
	return fmt.Sprintf("/pay/%s/status", tx.ID)
}

func qrURL(tx *database.Transaction) string {
	if tx.WidgetID.Valid {
		return fmt.Sprintf("/widget/qr/%s", tx.ID)
	}
	return fmt.Sprintf("/pay/%s/qr", tx.ID)
}

func remaining(tx *database.Transaction) int64 {
	if tx.Amount <= 0 {
		return 0
	}
	if tx.ReceivedAmount >= tx.Amount {
		return 0
	}
	return tx.Amount - tx.ReceivedAmount
}

func terminal(status database.TransactionStatus) bool {
	switch status {
	case database.StatusConfirmed, database.StatusExpired:
		return true
	default:
		return false
	}
}

templ Status(tx *database.Transaction, requiredConfirmations int, thankYouMessage string) {
	<div
		id="status"
		if !terminal(tx.Status) {
			hx-get={ statusURL(tx) }
			hx-trigger="every 3s"
			hx-swap="outerHTML"
		}
	>
		switch tx.Status {
			case database.StatusPending:
				<div class="flex items-center justify-center gap-3 text-brand-500 py-4">
					<svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
					</svg>
					<span class="text-sm font-mono font-medium">Waiting for payment...</span>
				</div>
			case database.StatusMempool:
				<div class="text-center py-4">
					<span class="material-symbols-outlined text-brand-500 text-2xl mb-2">radio_button_checked</span>
					<p class="text-sm font-headline font-bold text-gray-900 dark:text-on-surface">Payment detected!</p>
					<p class="text-xs font-mono text-gray-400 dark:text-on-surface-variant mt-1 uppercase tracking-widest">Waiting for confirmations...</p>
				</div>
			case database.StatusConfirming:
				<div class="text-center py-4">
					<p class="text-sm font-headline font-bold text-gray-900 dark:text-on-surface mb-3">Confirming...</p>
					<div class="w-full bg-gray-200 dark:bg-surface-container-high rounded-md h-2 mb-2">
						<div
							class="bg-brand-500 h-2 rounded-md transition-all duration-500"
							style={ fmt.Sprintf("width: %d%%", confirmationPercent(tx.Confirmations, requiredConfirmations)) }
						></div>
					</div>
					<p class="text-xs font-mono text-gray-400 dark:text-on-surface-variant uppercase tracking-widest">{ fmt.Sprintf("%d/%d confirmations", tx.Confirmations, requiredConfirmations) }</p>
				</div>
			case database.StatusPartial:
				<div class="text-center py-4">
					<span class="material-symbols-outlined text-yellow-500 text-3xl mb-2">error_outline</span>
					<p class="text-sm font-headline font-bold text-gray-900 dark:text-on-surface">Partial payment received</p>
					<p class="text-xs font-mono text-gray-500 dark:text-on-surface-variant mt-1">
						{ fmt.Sprintf("Required %s. Received %s.", components.FormatXMR(tx.Amount), components.FormatXMR(tx.ReceivedAmount)) }
					</p>
					<p class="text-sm font-headline font-bold text-brand-500 mt-3">
						{ fmt.Sprintf("Send %s more", components.FormatXMR(remaining(tx))) }
					</p>
					<div class="flex justify-center mt-4">
						<div class="bg-white p-2 rounded-lg">
							<img
								src={ fmt.Sprintf("%s?v=%d", qrURL(tx), tx.ReceivedAmount) }
								alt="Remaining amount QR code"
								class="w-32 h-32"
							/>
						</div>
					</div>
				</div>
			case database.StatusReverted:
				<div class="text-center py-4">
					<span class="material-symbols-outlined text-yellow-500 text-3xl mb-2">undo</span>
					<p class="text-sm font-headline font-bold text-gray-900 dark:text-on-surface">Payment left the mempool</p>
					<p class="text-xs font-mono text-gray-500 dark:text-on-surface-variant mt-1">If you already sent it, wait a moment. Tiponero keeps watching this address.</p>
				</div>
			case database.StatusConfirmed:
				<div class="text-center py-4">
					<span class="material-symbols-outlined text-brand-500 text-5xl mb-3" style="font-variation-settings: 'FILL' 1;">check_circle</span>
					if tx.IsPayment {
						<p class="text-lg font-headline font-bold text-gray-900 dark:text-on-surface">Payment confirmed!</p>
					} else {
						<p class="text-lg font-headline font-bold text-gray-900 dark:text-on-surface">Thank you!</p>
					}
					if thankYouMessage != "" {
						<p class="text-sm text-gray-500 dark:text-on-surface-variant mt-1 font-body">{ thankYouMessage }</p>
					} else if tx.IsPayment {
						<p class="text-sm text-gray-500 dark:text-on-surface-variant mt-1 font-body">Your payment has been received.</p>
					} else {
						<p class="text-sm text-gray-500 dark:text-on-surface-variant mt-1 font-body">Your donation has been confirmed.</p>
					}
				</div>
			case database.StatusExpired:
				<div class="text-center py-4">
					<span class="material-symbols-outlined text-gray-400 dark:text-on-surface-variant/60 text-3xl mb-2">timer_off</span>
					if tx.ReceivedAmount > 0 {
						<p class="text-sm font-headline font-medium text-gray-500 dark:text-on-surface-variant">This request expired before the full amount arrived.</p>
						<p class="text-xs font-mono text-gray-500 dark:text-on-surface-variant mt-1">{ fmt.Sprintf("Received %s.", components.FormatXMR(tx.ReceivedAmount)) }</p>
					} else {
						if tx.IsPayment {
							<p class="text-sm font-headline font-medium text-gray-500 dark:text-on-surface-variant">This payment request has expired.</p>
						} else {
							<p class="text-sm font-headline font-medium text-gray-500 dark:text-on-surface-variant">This donation request has expired.</p>
						}
						<p class="text-xs font-mono text-gray-400 dark:text-on-surface-variant/50 mt-1 uppercase tracking-widest">No payment received within time limit</p>
					}
				</div>
		}
		if terminal(tx.Status) {
			<script>
				(function() {
					try {
						window.parent.postMessage({
							source: 'tiponero',
							type: 'tiponero:status',
							status: { fmt.Sprintf("%q", string(tx.Status)) },
							transaction_id: { fmt.Sprintf("%q", tx.ID) },
							widget_id: { fmt.Sprintf("%q", tx.WidgetID.String) },
							amount: { tx.Amount },
							received_amount: { tx.ReceivedAmount }
						}, '*');
					} catch (e) {}
				})();
			</script>
		}
	</div>
}
