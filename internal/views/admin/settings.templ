package admin

import (
	"fmt"
	"time"

	"github.com/tiponero/tiponero-core/internal/database"
	"github.com/tiponero/tiponero-core/internal/monero"
	"github.com/tiponero/tiponero-core/internal/views/components"
	"github.com/tiponero/tiponero-core/internal/views/layouts"
)

templ Settings(user *database.User, wallet *database.WalletConfig, status monero.ConnectionStatus, apiKeys []database.APIKey) {
	@layouts.Admin("Settings", status) {
		@components.PageTitle("Settings")
		<div class="space-y-8">
			@components.SectionCard("Profile", "person") {
				<form hx-post="/admin/settings/profile" hx-swap="none" class="space-y-5">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
						@components.FormField("username", "Username", "text", user.Username, "admin", templ.Attributes{"required": true})
						@components.FormField("display_name", "Display name", "text", user.DisplayName, "Your public display name", templ.Attributes{})
					</div>
					@components.FormField("avatar_url", "Avatar URL", "url", user.AvatarURL, "https://example.com/avatar.png", templ.Attributes{})
					@components.FormTextarea("bio", "Bio", user.Bio, "Tell supporters about yourself", 3, templ.Attributes{})
					<div class="flex justify-end">
						@components.PrimaryButton("Save profile", false)
					</div>
				</form>
			}

			@components.SectionCard("Wallet", "account_balance_wallet") {
				<form hx-post="/admin/settings/wallet" hx-swap="none" class="space-y-5">
					<div class="grid grid-cols-1 md:grid-cols-3 gap-5">
						@components.FormField("rpc_url", "RPC URL", "url", wallet.RPCURL, "http://127.0.0.1:18088", templ.Attributes{"required": true})
						@components.FormField("rpc_user", "RPC user", "text", wallet.RPCUser, "", templ.Attributes{})
						@components.FormField("rpc_password", "RPC password", "password", wallet.RPCPassword, "", templ.Attributes{})
					</div>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
						@components.FormField("wallet_file", "Wallet file", "text", wallet.WalletFile, "", templ.Attributes{})
						@components.FormField("wallet_password", "Wallet password", "password", wallet.WalletPassword, "", templ.Attributes{})
					</div>
					@components.RPCStatusCard(status)
					<div class="flex justify-end">
						<button type="submit" name="action" value="save" class="bg-primary-container py-3 px-6 text-black font-headline font-bold uppercase tracking-widest hover:brightness-90 transition-all rounded-md text-sm">Save</button>
					</div>

					<div class="pt-6 border-t border-outline-variant/15 space-y-5">
						<h4 class="font-headline text-lg font-bold">Create view-only wallet</h4>
						<div class="grid grid-cols-1 md:grid-cols-3 gap-5">
							@components.FormField("address", "Primary address", "text", "", "4...", templ.Attributes{})
							@components.FormField("viewkey", "Private view key", "password", "", "", templ.Attributes{"minlength": "64", "maxlength": "64"})
							@components.FormField("restore_height", "Restore height", "number", "", "0", templ.Attributes{"min": "0"})
						</div>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
							@components.FormField("filename", "New wallet file", "text", "", "tiponero-view", templ.Attributes{})
						</div>
						<div class="flex justify-end">
							<button type="submit" name="action" value="create" class="bg-surface-container-high py-3 px-6 text-on-surface font-headline font-bold uppercase tracking-widest hover:bg-surface-bright transition-all rounded-md text-sm">Create wallet</button>
						</div>
					</div>
				</form>
			}

			@components.SectionCard("Account Security", "shield") {
				<form hx-post="/admin/settings/password" hx-swap="none" class="space-y-5">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
						@components.FormField("current_password", "Current password", "password", "", "", templ.Attributes{"required": true})
						@components.FormField("new_password", "New password", "password", "", "", templ.Attributes{"required": true, "minlength": "8"})
					</div>
					<div class="flex justify-end">
						@components.PrimaryButton("Update password", false)
					</div>
				</form>

				<div class="pt-6 mt-6 border-t border-outline-variant/15">
					if user.TOTPSecret != "" {
						<form hx-post="/admin/settings/totp/disable" hx-swap="none" class="flex flex-wrap items-end justify-between gap-4" x-data="{ code: '' }">
							<div class="flex items-center gap-3">
								<span class="material-symbols-outlined text-primary-container" style="font-variation-settings: 'FILL' 1;">verified_user</span>
								<p class="font-headline font-bold text-on-surface">Two-factor authentication is on</p>
							</div>
							<div class="flex items-end gap-3">
								<div class="space-y-1.5">
									<label for="disable_code" class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Code</label>
									<input type="text" id="disable_code" name="code" x-model="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="000000" required class="w-32 bg-surface-container-highest border-none text-on-surface p-3 font-mono text-center tracking-widest rounded-md focus:outline-none focus:ring-1 focus:ring-primary/30"/>
								</div>
								<button type="submit" x-bind:disabled="code.length !== 6" class="flex items-center gap-2 text-error text-sm font-headline font-bold uppercase tracking-widest hover:bg-error-container/20 py-3 px-6 rounded-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
									<span class="material-symbols-outlined text-sm">delete</span>
									Disable 2FA
								</button>
							</div>
						</form>
					} else {
						<div class="flex flex-wrap items-center justify-between gap-4">
							<div class="flex items-center gap-3">
								<span class="material-symbols-outlined text-on-surface-variant">shield</span>
								<p class="font-headline font-bold text-on-surface">Two-factor authentication is off</p>
							</div>
							<form method="POST" action="/admin/settings/totp/setup">
								@components.PrimaryButton("Enable 2FA", false)
							</form>
						</div>
					}
				</div>
			}

			@components.SectionCard("API Keys", "key") {
				<form hx-post="/admin/settings/api-keys" hx-target="#api-key-reveal" hx-swap="innerHTML" class="flex flex-wrap items-end gap-3 mb-6">
					<div class="flex-1 min-w-[200px] space-y-1.5">
						<label for="api_key_name" class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Name</label>
						<input type="text" id="api_key_name" name="name" required placeholder="Online Store" class="w-full bg-surface-container-highest border-none text-on-surface p-3 font-body text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-primary/30"/>
					</div>
					<div class="space-y-1.5">
						<label for="api_key_expiry" class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Expires in</label>
						<select id="api_key_expiry" name="expiry_days" class="bg-surface-container-highest border-none text-on-surface p-3 font-body text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-primary/30">
							<option value="30">30 days</option>
							<option value="90">90 days</option>
							<option value="180">180 days</option>
							<option value="365" selected>1 year</option>
						</select>
					</div>
					@components.PrimaryButton("Create key", false)
				</form>
				<div id="api-key-reveal"></div>
				<div id="api-key-list" class="space-y-2">
					for _, k := range apiKeys {
						@apiKeyRow(k)
					}
				</div>
				if len(apiKeys) == 0 {
					<p id="api-key-empty" class="text-sm text-on-surface-variant font-body text-center py-6">No API keys yet.</p>
				}
			}
		</div>
	}
}

templ apiKeyRow(k database.APIKey) {
	<div id={ fmt.Sprintf("api-key-%s", k.ID) } class="flex items-center justify-between p-3 rounded-lg bg-surface-container-low" x-data="{ confirmDelete: false }">
		<div class="flex items-center gap-4 min-w-0">
			<div class="min-w-0">
				<p class="text-sm font-bold text-on-surface truncate">{ k.Name }</p>
				<div class="flex items-center gap-3 text-xs text-on-surface-variant font-mono">
					<span>{ fmt.Sprintf("tip_%s...", k.Prefix) }</span>
					<span>&middot;</span>
					if isExpired(k.ExpiresAt) {
						<span class="text-error">Expired</span>
					} else {
						<span>Expires { formatUnix(k.ExpiresAt) }</span>
					}
					if k.LastUsedAt > 0 {
						<span>&middot;</span>
						<span>Last used { formatUnix(k.LastUsedAt) }</span>
					}
				</div>
			</div>
		</div>
		<div class="flex items-center gap-1 shrink-0">
			<template x-if="!confirmDelete">
				<button type="button" @click="confirmDelete = true" class="flex items-center gap-1 text-error text-xs font-mono uppercase tracking-widest leading-none hover:bg-error-container/20 px-2 py-1 rounded-md transition-colors cursor-pointer">
					<span class="material-symbols-outlined text-sm">delete</span>
					Delete
				</button>
			</template>
			<template x-if="confirmDelete">
				<div class="flex items-center gap-1">
					<span class="text-on-surface-variant text-xs font-mono leading-none">Sure?</span>
					<button type="button" @click="confirmDelete = false" class="text-on-surface-variant text-xs font-mono uppercase tracking-widest leading-none hover:bg-surface-container-high px-2 py-1 rounded-md transition-colors cursor-pointer">Cancel</button>
					<form class="flex" method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/settings/api-keys/%s/delete", k.ID)) }>
						<button type="submit" class="text-error text-xs font-mono uppercase tracking-widest leading-none hover:bg-error-container/20 px-2 py-1 rounded-md transition-colors font-bold cursor-pointer">Delete</button>
					</form>
				</div>
			</template>
		</div>
	</div>
}

func formatUnix(ts int64) string {
	return time.Unix(ts, 0).Format("Jan 2, 2006")
}

func isExpired(expiresAt int64) bool {
	return time.Now().Unix() > expiresAt
}
