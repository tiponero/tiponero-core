package admin

import (
	"encoding/json"
	"fmt"
	"sort"
	"time"

	"github.com/tiponero/tiponero-core/internal/database"
	"github.com/tiponero/tiponero-core/internal/monero"
	"github.com/tiponero/tiponero-core/internal/services"
	"github.com/tiponero/tiponero-core/internal/views/components"
	"github.com/tiponero/tiponero-core/internal/views/layouts"
)

// confirmationOptions lists the confirmation counts the admin panel offers.
// The global default is always present so it can be preselected.
func confirmationOptions(global int) []int {
	options := []int{0, 1, 2, 3, 5, 10, 15, 20, 30, 60}
	found := false
	for _, n := range options {
		if n == global {
			found = true
			break
		}
	}
	if !found {
		options = append(options, global)
		sort.Ints(options)
	}
	return options
}

// effectiveConfirmations turns the stored -1 into the global default.
func effectiveConfirmations(stored, global int) int {
	if stored < 0 {
		return global
	}
	return stored
}

templ Widgets(widgets []database.Widget, hostURL string, rpcStatus monero.ConnectionStatus, globalConfirmations int) {
	@layouts.Admin("Widgets", rpcStatus) {
		@components.PageTitle("Widgets")
		<script>
			(function() {
				var p = new URLSearchParams(window.location.search);
				var t = p.get('toast');
				if (t) {
					history.replaceState(null, '', window.location.pathname);
					document.addEventListener('alpine:initialized', function() {
						if (t === 'created') Alpine.store('toast').show('success', 'Widget created.');
						if (t === 'deleted') Alpine.store('toast').show('success', 'Widget deleted.');
						if (t === 'updated') Alpine.store('toast').show('success', 'Widget updated.');
					}, { once: true });
				}
			})();
		</script>

		<div class="space-y-8">
			@components.SectionCard("Create Widget", "add_box") {
				<form
					method="POST"
					action="/admin/widgets"
					class="space-y-5"
					x-data="{
						mode: 'donation',
						presets: [0.01, 0.05, 0.1],
						newPreset: '',
						addPreset() {
							var v = parseFloat(this.newPreset);
							if (!isNaN(v) && v > 0 && this.presets.indexOf(v) === -1) {
								this.presets.push(v);
								this.newPreset = '';
							}
						},
						removePreset(i) { this.presets.splice(i, 1); },
						presetsJSON() { return this.presets.length > 0 ? JSON.stringify(this.presets) : ''; }
					}"
					@submit="$refs.preset_amounts_input.value = presetsJSON()"
				>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
						@components.FormField("name", "Name", "text", "", "Blog sidebar", templ.Attributes{"required": true})
						<div class="space-y-1.5">
							<label class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Mode</label>
							<div class="grid grid-cols-2 gap-2">
								<button type="button" @click="mode = 'donation'" :class="mode === 'donation' ? 'bg-primary-container/20 text-primary-container ring-1 ring-primary-container/30' : 'bg-surface-container-high text-on-surface-variant hover:bg-surface-bright'" class="py-2.5 rounded-md text-sm font-mono font-medium transition-all text-center">Donation</button>
								<button type="button" @click="mode = 'payment'" :class="mode === 'payment' ? 'bg-primary-container/20 text-primary-container ring-1 ring-primary-container/30' : 'bg-surface-container-high text-on-surface-variant hover:bg-surface-bright'" class="py-2.5 rounded-md text-sm font-mono font-medium transition-all text-center">Payment</button>
							</div>
							<input type="hidden" name="mode" x-bind:value="mode"/>
						</div>
					</div>

					<div x-show="mode === 'donation'" class="space-y-1.5">
						<label class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Preset amounts</label>
						<div class="flex gap-2">
							<input type="number" x-model="newPreset" step="0.000000000001" min="0.000000000001" placeholder="0.25" @keydown.enter.prevent="addPreset()" class="flex-1 bg-surface-container-highest border-none text-on-surface p-3 font-mono text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-primary/30"/>
							<button type="button" @click="addPreset()" class="px-4 bg-surface-container-high text-on-surface-variant hover:bg-surface-bright text-xs font-mono uppercase tracking-widest rounded-md transition-colors">Add</button>
						</div>
						<div class="flex flex-wrap gap-2" x-show="presets.length > 0">
							<template x-for="(preset, index) in presets" :key="index">
								<span class="inline-flex items-center gap-1 bg-primary-container/10 text-primary-container text-xs font-mono px-2 py-1 rounded-md">
									<span x-text="preset"></span>
									<button type="button" @click="removePreset(index)" class="text-error text-base leading-none ml-0.5 hover:brightness-125 transition-colors cursor-pointer">&times;</button>
								</span>
							</template>
						</div>
						<input type="hidden" name="preset_amounts" x-ref="preset_amounts_input"/>
					</div>

					<div x-show="mode === 'payment'" x-cloak class="grid grid-cols-1 md:grid-cols-3 gap-5">
						@components.FormField("payment_price", "Price XMR", "number", "", "0.05", templ.Attributes{"step": "0.000000000001", "min": "0"})
						@components.FormField("price_fiat", "Price fiat", "number", "", "0.00", templ.Attributes{"step": "0.01", "min": "0"})
						<div class="space-y-1.5">
							<label for="price_currency" class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Currency</label>
							@currencySelect("price_currency", "price_currency", "", false)
						</div>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
						<div class="space-y-1.5">
							<label for="confirmations" class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Confirmations</label>
							@confirmationsSelect("confirmations", "confirmations", globalConfirmations, globalConfirmations)
						</div>
						@components.FormField("redirect_url", "Redirect URL", "url", "", "https://example.com/thank-you", templ.Attributes{})
					</div>

					<div x-show="mode === 'donation'" x-cloak class="grid grid-cols-1 md:grid-cols-3 gap-5">
						@components.FormField("goal_amount", "Goal", "number", "", "0.00", templ.Attributes{"step": "0.01", "min": "0"})
						<div class="space-y-1.5">
							<label for="goal_currency" class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Goal currency</label>
							@currencySelect("goal_currency", "goal_currency", "XMR", true)
						</div>
						<div class="space-y-1.5">
							<label for="goal_deadline" class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Goal deadline</label>
							<input type="date" id="goal_deadline" name="goal_deadline" class="w-full bg-surface-container-highest border-none text-on-surface p-3 font-body text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-primary/30"/>
						</div>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
						@components.FormField("button_text", "Button text", "text", "Donate", "", templ.Attributes{})
						@components.FormField("custom_message", "Custom message", "text", "Your support is appreciated!", "", templ.Attributes{})
					</div>
					@components.FormField("thank_you_message", "Thank you message", "text", "", "Thank you for your donation!", templ.Attributes{})

					<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
						<div class="space-y-1.5">
							<label for="primary_color" class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Accent color</label>
							<div class="space-y-2 p-2 bg-surface-container-highest rounded-md" x-data="{ color: '#ff6600' }">
								<div class="flex gap-2 items-center">
									<button type="button" @click="color = '#FF6600'" :class="color === '#FF6600' ? 'ring-2 ring-white/70 ring-offset-2 ring-offset-surface-container-highest' : ''" class="w-8 h-8 rounded-md bg-[#FF6600] transition-all shrink-0"></button>
									<button type="button" @click="color = '#009cfc'" :class="color === '#009cfc' ? 'ring-2 ring-white/70 ring-offset-2 ring-offset-surface-container-highest' : ''" class="w-8 h-8 rounded-md bg-[#009cfc] transition-all shrink-0"></button>
									<button type="button" @click="color = '#9ccaff'" :class="color === '#9ccaff' ? 'ring-2 ring-white/70 ring-offset-2 ring-offset-surface-container-highest' : ''" class="w-8 h-8 rounded-md bg-[#9ccaff] transition-all shrink-0"></button>
									<button type="button" @click="color = '#ffb4ab'" :class="color === '#ffb4ab' ? 'ring-2 ring-white/70 ring-offset-2 ring-offset-surface-container-highest' : ''" class="w-8 h-8 rounded-md bg-[#ffb4ab] transition-all shrink-0"></button>
								</div>
								<div class="flex items-center gap-2">
									<input type="color" x-model="color" class="w-8 h-8 rounded-md cursor-pointer bg-transparent border-none p-0 shrink-0 [&::-webkit-color-swatch-wrapper]:p-0 [&::-webkit-color-swatch]:rounded-md [&::-webkit-color-swatch]:border-none [&::-moz-color-swatch]:rounded-md [&::-moz-color-swatch]:border-none"/>
									<input type="text" x-model="color" maxlength="7" pattern="^#[0-9a-fA-F]{6}$" class="flex-1 bg-surface-container-high border-none text-on-surface-variant font-mono text-xs p-1.5 rounded-md focus:outline-none focus:ring-1 focus:ring-primary/30 uppercase"/>
								</div>
								<input type="hidden" name="primary_color" x-bind:value="color"/>
							</div>
						</div>
						<div class="space-y-1.5">
							<label for="theme" class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Theme</label>
							<select id="theme" name="theme" class="w-full bg-surface-container-highest border-none text-on-surface p-3 font-body text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-primary/30 appearance-none">
								<option value="system">System</option>
								<option value="light">Light</option>
								<option value="dark">Dark</option>
							</select>
						</div>
					</div>

					<div class="flex items-center justify-between gap-4 pt-2">
						<label class="flex items-center gap-2 text-sm font-body text-on-surface-variant">
							<input type="checkbox" id="show_stats" name="show_stats" checked class="rounded-md border-outline-variant bg-surface-container-highest text-primary-container focus:ring-primary/30"/>
							Show stats on badge
						</label>
						@components.PrimaryButton("Create Widget", false)
					</div>
				</form>
			}

			<div class="space-y-6">
				if len(widgets) == 0 {
					<div class="bg-surface-container-lowest rounded-xl">
						@components.EmptyState("widgets", "No widgets yet.")
					</div>
				}
				for _, w := range widgets {
					@widgetCard(w, hostURL, globalConfirmations)
				}
			</div>
		</div>
	}
}

templ confirmationsSelect(id, name string, selected, global int) {
	<select id={ id } name={ name } class="w-full bg-surface-container-highest border-none text-on-surface p-3 font-body text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-primary/30 appearance-none">
		for _, n := range confirmationOptions(global) {
			<option value={ fmt.Sprintf("%d", n) } selected?={ n == selected }>{ fmt.Sprintf("%d", n) }</option>
		}
	</select>
}

templ currencySelect(id, name, selected string, includeXMR bool) {
	<select id={ id } name={ name } class="w-full bg-surface-container-highest border-none text-on-surface p-3 font-body text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-primary/30 appearance-none">
		if includeXMR {
			<option value="XMR" selected?={ selected == "XMR" }>XMR</option>
		}
		for _, c := range services.SupportedCurrencies {
			<option value={ c } selected?={ c == selected }>{ c }</option>
		}
	</select>
}

templ widgetCard(w database.Widget, hostURL string, globalConfirmations int) {
	<div
		x-data="{ open: false, confirmDelete: false, copied: false, copyText(ref) { var t = this.$refs[ref].textContent.trim(); var self = this; var fallback = function() { var ta = document.createElement('textarea'); ta.value = t; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta); self.copied = ref; setTimeout(function(){ self.copied = false }, 2000) }; if (navigator.clipboard && window.isSecureContext) { navigator.clipboard.writeText(t).then(function() { self.copied = ref; setTimeout(function(){ self.copied = false }, 2000) }).catch(fallback) } else { fallback() } } }"
		class="bg-surface-container-lowest border-l-4 border-tertiary group transition-all hover:bg-monero-gray/20"
	>
		<div class="flex items-center justify-between p-6">
			<div class="flex items-center gap-4 cursor-pointer flex-1 min-w-0" @click="open = !open">
				<span class="material-symbols-outlined text-on-surface-variant text-lg transition-transform" :class="open && 'rotate-90'">chevron_right</span>
				<div class="min-w-0">
					<h4 class="font-headline text-lg font-bold text-on-surface truncate">{ w.Name }</h4>
					<p class="text-xs text-on-surface-variant truncate font-body">{ w.CustomMessage }</p>
				</div>
			</div>
			<div class="flex items-center gap-3 ml-4">
				if w.Mode == database.ModePayment {
					<span class="inline-flex items-center gap-1 bg-primary-container/10 text-primary-container text-xs font-mono px-2 py-0.5 rounded-md uppercase">
						<span class="material-symbols-outlined text-xs">payment</span>
						Payment
					</span>
				} else {
					<span class="inline-flex items-center gap-1 bg-primary-container/10 text-primary-container text-xs font-mono px-2 py-0.5 rounded-md uppercase">
						<span class="material-symbols-outlined text-xs">volunteer_activism</span>
						Donation
					</span>
				}
				<div class="flex items-center gap-1">
					<template x-if="!confirmDelete">
						<button type="button" @click="confirmDelete = true" class="flex items-center gap-1 text-error text-xs font-mono uppercase tracking-widest hover:bg-error-container/20 px-2 py-1 rounded-md transition-colors">
							<span class="material-symbols-outlined text-sm">delete</span>
							Delete
						</button>
					</template>
					<template x-if="confirmDelete">
						<div class="flex items-center gap-1">
							<span class="text-on-surface-variant text-xs font-mono leading-none">Sure?</span>
							<button type="button" @click="confirmDelete = false" class="text-on-surface-variant text-xs font-mono uppercase tracking-widest leading-none hover:bg-surface-container-high px-2 py-1 rounded-md transition-colors">Cancel</button>
							<form class="flex" method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/widgets/%s/delete", w.ID)) }>
								<button type="submit" class="text-error text-xs font-mono uppercase tracking-widest leading-none hover:bg-error-container/20 px-2 py-1 rounded-md transition-colors font-bold">Delete</button>
							</form>
						</div>
					</template>
				</div>
			</div>
		</div>
		<div x-show="open" x-cloak x-transition class="p-6 pt-0 space-y-6">
			<div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
				<div class="rounded-lg overflow-hidden bg-surface-container-high">
					<iframe
						src={ fmt.Sprintf("/widget/%s", w.ID) }
						width="100%"
						height="480"
						frameborder="0"
						sandbox="allow-same-origin allow-scripts"
						class="bg-surface"
						onload="this.contentWindow.postMessage({prefersDark:true},'*')"
					></iframe>
				</div>
				<div class="space-y-4">
					<img src={ fmt.Sprintf("/widget/%s/badge.svg", w.ID) } alt="Widget badge" class="rounded-md max-w-full h-auto"/>
					@widgetEditForm(w, globalConfirmations)
				</div>
			</div>
			<details class="group/details">
				<summary class="flex cursor-pointer items-center justify-between rounded-md px-4 py-3 text-xs font-mono uppercase tracking-widest text-on-surface-variant bg-surface-container-high hover:bg-surface-bright transition-colors">
					<span class="flex items-center gap-2">
						<span class="material-symbols-outlined text-sm">code</span>
						Widget Embed
					</span>
					<span class="material-symbols-outlined text-sm transition-transform group-open/details:rotate-180">expand_more</span>
				</summary>
				<div class="mt-3 space-y-3">
					@copyBox("Widget URL", "widgetUrl", fmt.Sprintf(`%s/widget/%s`, hostURL, w.ID))
					@copyBox("Embed Code", "embedCode", fmt.Sprintf(`<iframe src="%s/widget/%s" width="400" height="600" frameborder="0"></iframe>`, hostURL, w.ID))
				</div>
			</details>
			<details class="group/details">
				<summary class="flex cursor-pointer items-center justify-between rounded-md px-4 py-3 text-xs font-mono uppercase tracking-widest text-on-surface-variant bg-surface-container-high hover:bg-surface-bright transition-colors">
					<span class="flex items-center gap-2">
						<span class="material-symbols-outlined text-sm">badge</span>
						Badge Embed
					</span>
					<span class="material-symbols-outlined text-sm transition-transform group-open/details:rotate-180">expand_more</span>
				</summary>
				<div class="mt-3 space-y-3">
					@copyBox("Badge URL", "badgeUrl", fmt.Sprintf(`%s/widget/%s/badge.svg`, hostURL, w.ID))
					@copyBox("Markdown", "badgeMarkdown", fmt.Sprintf(`[![Donate with Tiponero](%s/widget/%s/badge.svg)](%s/widget/%s)`, hostURL, w.ID, hostURL, w.ID))
				</div>
			</details>
		</div>
	</div>
}

templ copyBox(label string, refName string, value string) {
	<div class="bg-surface-container-lowest rounded-md p-4">
		<div class="flex items-center justify-between mb-2">
			<p class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">{ label }</p>
			<button
				type="button"
				x-on:click={ fmt.Sprintf("copyText('%s')", refName) }
				class="text-xs font-mono uppercase tracking-widest px-2 py-1 rounded-md transition-colors"
				x-bind:class={ fmt.Sprintf("copied === '%s' ? 'bg-primary-container/10 text-primary-container' : 'bg-surface-container-high text-on-surface-variant hover:bg-surface-bright'", refName) }
				x-text={ fmt.Sprintf("copied === '%s' ? 'Copied!' : 'Copy'", refName) }
			>Copy</button>
		</div>
		<code x-ref={ refName } class="block text-xs font-mono text-on-surface-variant break-all select-all">{ value }</code>
	</div>
}

templ widgetEditForm(w database.Widget, globalConfirmations int) {
	<details class="bg-surface-container-high/40 rounded-md">
		<summary class="cursor-pointer px-4 py-3 text-xs font-mono uppercase tracking-widest text-on-surface-variant">Edit widget</summary>
		<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/widgets/%s/update", w.ID)) } class="p-4 pt-0 space-y-4" x-data="{ mode: 'donation' }" x-init={ fmt.Sprintf("mode = '%s'", string(w.Mode)) }>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				@components.FormFieldNamed("name-"+w.ID, "name", "Name", "text", w.Name, "Blog sidebar", templ.Attributes{"required": true})
				<div class="space-y-1.5">
					<label for={ "mode-" + w.ID } class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Mode</label>
					<select id={ "mode-" + w.ID } name="mode" x-model="mode" class="w-full bg-surface-container-highest border-none text-on-surface p-3 font-body text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-primary/30 appearance-none">
						<option value="donation">Donation</option>
						<option value="payment">Payment</option>
					</select>
				</div>
			</div>

			<div x-show="mode === 'donation'" x-cloak class="space-y-1.5">
				<label for={ "presets-" + w.ID } class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Preset amounts</label>
				<input type="text" id={ "presets-" + w.ID } name="preset_amounts" value={ w.PresetAmounts } placeholder="[0.01,0.05,0.1]" class="w-full bg-surface-container-highest border-none text-on-surface p-3 font-mono text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-primary/30"/>
			</div>

			<div x-show="mode === 'payment'" x-cloak class="grid grid-cols-1 md:grid-cols-3 gap-4">
				@components.FormFieldNamed("payment_price-"+w.ID, "payment_price", "Price XMR", "number", presetValue(w.PresetAmounts), "0.05", templ.Attributes{"step": "0.000000000001", "min": "0"})
				@components.FormFieldNamed("price_fiat-"+w.ID, "price_fiat", "Price fiat", "number", floatValue(w.PriceFiat), "0.00", templ.Attributes{"step": "0.01", "min": "0"})
				<div class="space-y-1.5">
					<label for={ "price_currency-" + w.ID } class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Currency</label>
					@currencySelect("price_currency-"+w.ID, "price_currency", w.PriceCurrency, false)
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				<div class="space-y-1.5">
					<label for={ "confirmations-" + w.ID } class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Confirmations</label>
					@confirmationsSelect("confirmations-"+w.ID, "confirmations", effectiveConfirmations(w.Confirmations, globalConfirmations), globalConfirmations)
				</div>
				@components.FormFieldNamed("redirect_url-"+w.ID, "redirect_url", "Redirect URL", "url", w.RedirectURL, "https://example.com/thank-you", templ.Attributes{})
			</div>

			<div x-show="mode === 'donation'" x-cloak class="grid grid-cols-1 md:grid-cols-3 gap-4">
				@components.FormFieldNamed("goal_amount-"+w.ID, "goal_amount", "Goal", "number", floatValue(w.GoalAmount), "0.00", templ.Attributes{"step": "0.01", "min": "0"})
				<div class="space-y-1.5">
					<label for={ "goal_currency-" + w.ID } class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Goal currency</label>
					@currencySelect("goal_currency-"+w.ID, "goal_currency", goalCurrency(w), true)
				</div>
				<div class="space-y-1.5">
					<label for={ "goal_deadline-" + w.ID } class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Goal deadline</label>
					<input type="date" id={ "goal_deadline-" + w.ID } name="goal_deadline" value={ dateValue(w.GoalDeadline) } class="w-full bg-surface-container-highest border-none text-on-surface p-3 font-body text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-primary/30"/>
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				@components.FormFieldNamed("button_text-"+w.ID, "button_text", "Button text", "text", w.ButtonText, "Donate", templ.Attributes{})
				@components.FormFieldNamed("custom_message-"+w.ID, "custom_message", "Custom message", "text", w.CustomMessage, "Your support is appreciated!", templ.Attributes{})
			</div>
			@components.FormFieldNamed("thank_you_message-"+w.ID, "thank_you_message", "Thank you message", "text", w.ThankYouMessage, "Thank you!", templ.Attributes{})

			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				@components.FormFieldNamed("primary_color-"+w.ID, "primary_color", "Accent color", "text", w.PrimaryColor, "#ff6600", templ.Attributes{"pattern": "^#[0-9a-fA-F]{6}$"})
				<div class="space-y-1.5">
					<label for={ "theme-" + w.ID } class="text-xs font-mono uppercase tracking-widest text-on-surface-variant">Theme</label>
					<select id={ "theme-" + w.ID } name="theme" class="w-full bg-surface-container-highest border-none text-on-surface p-3 font-body text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-primary/30 appearance-none">
						<option value="system" selected?={ w.Theme == database.ThemeSystem }>System</option>
						<option value="light" selected?={ w.Theme == database.ThemeLight }>Light</option>
						<option value="dark" selected?={ w.Theme == database.ThemeDark }>Dark</option>
					</select>
				</div>
			</div>

			<div class="flex items-center justify-between gap-4">
				<label class="flex items-center gap-2 text-sm font-body text-on-surface-variant">
					<input type="checkbox" name="show_stats" checked?={ w.ShowStats } class="rounded-md border-outline-variant bg-surface-container-highest text-primary-container focus:ring-primary/30"/>
					Show stats on badge
				</label>
				@components.PrimaryButton("Save changes", false)
			</div>
		</form>
	</details>
}

// presetValue returns the single XMR preset for the payment price field.
func presetValue(raw string) string {
	var amounts []float64
	if err := json.Unmarshal([]byte(raw), &amounts); err != nil || len(amounts) != 1 {
		return ""
	}
	return fmt.Sprintf("%g", amounts[0])
}

func goalCurrency(w database.Widget) string {
	if w.GoalCurrency == "" {
		return "XMR"
	}
	return w.GoalCurrency
}

func floatValue(v float64) string {
	if v == 0 {
		return ""
	}
	return fmt.Sprintf("%g", v)
}

func dateValue(unix int64) string {
	if unix == 0 {
		return ""
	}
	return time.Unix(unix, 0).Format("2006-01-02")
}
