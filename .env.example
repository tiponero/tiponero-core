# Copy this file to .env and change every value marked CHANGE ME.

# HTTP listen port.
PORT=8080

# Public base URL. Links in webhooks, badges, and payment pages use it.
# Set it to your .onion address when you serve Tiponero over Tor.
BASE_URL=http://localhost:8080

# SQLite file. Leave empty for an in-memory database (data is lost on restart).
DATABASE_PATH=./tiponero.db

# Master key for sessions and for AES-256-GCM encryption at rest.
# It must be at least 32 characters. CHANGE ME.
# Losing this value makes stored wallet passwords and webhook secrets unreadable.
ENCRYPTION_KEY=change-me-in-production-32-chars

# Default fiat currency for price display and fiat pricing.
FIAT_CURRENCY=USD

# Block confirmations before a payment is final. A widget or a payment request
# can override this, including 0 for mempool-only (0-conf).
CONFIRMATIONS=10

# How long a payment request stays open. Go duration syntax.
TRANSACTION_EXPIRY=1h

# Optional. Enables the CoinMarketCap fallback when CoinGecko fails.
COINMARKETCAP_API_KEY=

# Optional. Adds a "Simulate payment" button in the admin panel. Test rows are
# excluded from statistics and CSV export. Never enable this in production.
MOCK_PAYMENTS=false

# Set to true only when a reverse proxy you control sets X-Forwarded-For.
# Without it, rate limiting uses the direct connection address.
TRUST_PROXY=false
